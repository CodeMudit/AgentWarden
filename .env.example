# Application
APP_NAME=AgentWarden
APP_VERSION=0.1.0
DEBUG=false
DEMO_MODE=true
# When DEMO_MODE=false, SECRET_KEY and LEDGER_CHECKPOINT_KEY must be strong non-default values or the app refuses to start.
SECRET_KEY=change-me-to-a-long-random-string-in-production
LEDGER_CHECKPOINT_KEY=change-me-ledger-hmac-key

# Database (SQLite default; set DATABASE_URL for Postgres)
DATABASE_URL=sqlite:///./agentwarden.db
# DATABASE_URL=postgresql://agentwarden:agentwarden@localhost:5432/agentwarden

# Approval SLA (seconds). Demo Lab uses a short SLA for live escalation.
APPROVAL_SLA_SECONDS=900

# Optional: Anthropic API for plain-language summary rewording and llm_agent.py
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
HOST=0.0.0.0
PORT=8000
